<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>Loadout</RootNamespace>
    <AssemblyName>Loadout</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\loadout.ico</ApplicationIcon>
    <Version>0.1.0</Version>
    <Product>Loadout</Product>
    <Description>A radial app launcher for Windows.</Description>
    <Copyright>Licensed under GPL-3.0</Copyright>

    <!-- Keep the app light (SPEC section 8). -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseSystemResourceKeys>false</UseSystemResourceKeys>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\loadout.ico" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Loadout.Tests" />
  </ItemGroup>

</Project>
